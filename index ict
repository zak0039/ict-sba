<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Input Dashboard | Gamified Homework Tracking System</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <div class="card">
        <header>
          <h2>Assign Task</h2>
          <p>Assign task for people join to team</p>
        </header>
      
        <form>
          <div class="row">
            <!-- First Dropdown List -->
            <div class="input-group">
              <label for="assign-to">Assign to</label>
              <select id="assign-to" name="assign-to">
                <option value="subject">Subject</option>
              </select>
            </div>
          
            
            <div class="input-group">
              <label>Assign To:</label>
              <div class="checkbox-grid">
             
                <!-- Column 1: Core Classes -->
                <div class="grid-column">
                  <h4>Core Classes</h4>
                  <label><input type="checkbox" name="classes" value="1a"> Class 1A</label>
                  <label><input type="checkbox" name="classes" value="1b"> Class 1B</label>
                </div>
            
                <!-- Column 2: Elective Splits -->
                <div class="grid-column">
                  <h4>Elective Blocks</h4>
                  <label><input type="checkbox" name="classes" value="elec-art"> Art Block A</label>
                  <label><input type="checkbox" name="classes" value="elec-music"> Music Block B</label>
                </div>
            
              </div>
            </div>
            
          
            <div class="input-group">
              <label for="due-date">Due Date</label>
               <input type="date" id="due-date" name="due-date">
            </div>
          </div>
      
          <div class="upload-container">
            <p>Choose a file or drag & drop it here</p>
            <input type="file" id="file-upload">
          </div>
      
          <div class="actions">
            <button type="button" class="btn-secondary">Save as Draft</button>
            <div>
              <button type="reset" class="btn-outline">Reset Data</button>
              <button type="submit" class="btn-primary">Save Task</button>
            </div>
          </div>
        </form>
    </div>

</body>
</html>
